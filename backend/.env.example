NODE_ENV=production
PORT=3000
# Neon pooled URL for application runtime. Host should include "-pooler".
DATABASE_URL=""
# Neon direct URL for Prisma CLI migrations/db push. Host should not include "-pooler".
DIRECT_URL=""
DATABASE_URL_TEST=
JWT_SECRET=
JWT_SECRET_TEST=
JWT_EXPIRES_IN=1d
FRONTEND_URL=
CORS_ORIGIN=
CORS_ORIGINS=
AI_SERVICE_URL=http://localhost:8000
CLIENT_RESET_PASSWORD_PATH=/auth/reset-password
ADMIN_RESET_PASSWORD_PATH=/admin/reset-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.pcsystemstore.com/auth/google/callback
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="PCSystemStore <onboarding@resend.dev>"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_COMMISSION_RATE=0.04
PAYMENTS_ENABLED=false
PAYMENT_SIMULATION_ENABLED=false
CHECKOUT_MODE=CONTACT_ONLY
PYTHON_EXECUTABLE=
QA_ADMIN_PASSWORD=
QA_EMPLOYEE_PASSWORD=
QA_CLIENT_PASSWORD=
