NODE_ENV=production
# Railway injects PORT at runtime; do not define a fixed PORT there.
# The backend falls back to 3000 locally when PORT is absent.
# PORT=3000
# Neon pooled URL for application runtime. Host should include "-pooler" and
# query parameters should include sslmode=verify-full&channel_binding=require.
DATABASE_URL=""
# Neon direct URL for Prisma CLI migrations/db push. Host should not include
# "-pooler" and should include sslmode=verify-full&channel_binding=require.
DIRECT_URL=""
DATABASE_URL_TEST=
JWT_SECRET=
JWT_SECRET_TEST=
JWT_EXPIRES_IN=1d
# Canonical production storefront. The legacy .com.pe domain must only redirect
# at the DNS/domain layer and must not be added as an application origin.
FRONTEND_URL=https://www.pcsystemstore.com
# Legacy single-origin variable; leave empty when CORS_ORIGINS is configured.
CORS_ORIGIN=
CORS_ORIGINS=https://www.pcsystemstore.com,https://pcsystemstore.com
CSRF_ALLOWED_ORIGINS=https://www.pcsystemstore.com,https://pcsystemstore.com
# Safe values exposed by GET /version. Railway also provides RAILWAY_GIT_COMMIT_SHA.
APP_VERSION=
COMMIT_SHA=
# Railway/Vercel topology: trust only the nearest reverse-proxy hop.
TRUST_PROXY=1
# Use none for cross-site Vercel -> Railway; use lax if frontend/API share a registrable site.
COOKIE_SAME_SITE=none
BODY_LIMIT=1mb
EXCEL_MAX_FILE_SIZE=5242880
ZIP_MAX_FILE_SIZE=52428800
IMPORT_MAX_ROWS=2000
IMPORT_MAX_COLUMNS=128
IMPORT_MAX_SHEETS=8
IMPORT_MAX_ZIP_ENTRIES=500
IMPORT_MAX_UNCOMPRESSED_SIZE=209715200
IMPORT_MAX_COMPRESSION_RATIO=100
ADMIN_LOGIN_MAX_ATTEMPTS=4
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCK_MINUTES=15
# HMAC secret used only to derive non-reversible account/IP rate-limit keys.
RATE_LIMIT_KEY_SECRET=
CUSTOMER_LOGIN_MAX_ATTEMPTS=4
CUSTOMER_LOGIN_WINDOW_MINUTES=60
CUSTOMER_LOGIN_INITIAL_LOCK_MINUTES=60
CUSTOMER_LOGIN_ESCALATED_LOCK_HOURS=24
CUSTOMER_LOGIN_IP_MAX_ATTEMPTS=20
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AI_SERVICE_URL=http://localhost:8000
CLIENT_RESET_PASSWORD_PATH=/auth/reset-password
ADMIN_RESET_PASSWORD_PATH=/admin/reset-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.pcsystemstore.com/auth/google/callback
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="PCSystemStore <onboarding@resend.dev>"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_COMMISSION_RATE=0.04
PAYMENTS_ENABLED=false
PAYMENT_SIMULATION_ENABLED=false
CHECKOUT_MODE=CONTACT_ONLY
PYTHON_EXECUTABLE=
QA_ADMIN_PASSWORD=
QA_EDITOR_PASSWORD=
QA_CLIENT_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=
SEED_CUSTOMER_PASSWORD=
# The destructive development seed is blocked in production unless this exact
# one-time acknowledgement is set. Do not persist it in Railway.
ALLOW_PRODUCTION_SEED=false
# Required only when applying (not previewing) scripts/diagnose-products.ts.
CONFIRM_PRODUCT_DEACTIVATION=
MAX_PRODUCT_DEACTIVATION=100
