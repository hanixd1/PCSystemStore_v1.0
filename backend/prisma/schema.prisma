generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                     String                  @id @default(uuid())
  // Maps to Odoo product default_code for future inventory synchronization.
  sku                    String                  @unique
  slug                   String                  @unique
  name                   String
  description            String?
  price                  Decimal                 @db.Decimal(10, 2)
  isOnSale               Boolean                 @default(false)
  salePrice              Decimal?                @db.Decimal(10, 2)
  stock                  Int
  images                 String[]
  category               String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  caseSpecs              CaseSpecs?
  coolerSpecs            CoolerSpecs?
  cpuSpecs               CpuSpecs?
  desktopSpecs           DesktopSpecs?
  gpuSpecs               GpuSpecs?
  headsetSpecs           HeadsetSpecs?
  keyboardSpecs          KeyboardSpecs?
  laptopSpecs            LaptopSpecs?
  microphoneSpecs        MicrophoneSpecs?
  monitorSpecs           MonitorSpecs?
  motherboardSpecs       MotherboardSpecs?
  mouseSpecs             MouseSpecs?
  mousepadSpecs          MousepadSpecs?
  chairSpecs             ChairSpecs?
  gamingDeskSpecs        GamingDeskSpecs?
  psuSpecs               PsuSpecs?
  ramSpecs               RamSpecs?
  softwareSpecs          SoftwareSpecs?
  speakerSpecs           SpeakerSpecs?
  webcamSpecs            WebcamSpecs?
  captureCardSpecs       CaptureCardSpecs?
  cableHubSpecs          CableHubSpecs?
  laptopCoolingBaseSpecs LaptopCoolingBaseSpecs?
  backpackSpecs          BackpackSpecs?
  storageSpecs           StorageSpecs?
  orderItems             OrderItem[]
}

model CpuSpecs {
  id                 String  @id @default(uuid())
  productId          String  @unique
  brand              String?
  socket             String
  cores              Int
  threads            Int?
  frequency          String
  baseTdpWatts       Int?
  tdp                Int
  integratedGraphics Boolean
  includesCooler     Boolean
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MotherboardSpecs {
  id                     String   @id @default(uuid())
  productId              String   @unique
  brand                  String?
  socket                 String
  formFactor             String
  memoryType             String
  memorySlots            Int
  m2Slots                Int
  supportedM2FormFactors String[] @default([])
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model RamSpecs {
  id         String  @id @default(uuid())
  productId  String  @unique
  brand      String?
  memoryType String
  capacity   Int
  speed      Int
  modules    Int
  latency    String?
  hasRGB     Boolean
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GpuSpecs {
  id                  String  @id @default(uuid())
  productId           String  @unique
  brand               String?
  chipset             String
  vram                Int
  typeVram            String?
  length              Int
  tdp                 Int
  gpuPowerWatts       Int?
  recommendedPsuWatts Int?
  fans                Int
  product             Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PsuSpecs {
  id            String  @id @default(uuid())
  productId     String  @unique
  brand         String?
  wattage       Int
  certification String
  modular       String
  formFactor    String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CaseSpecs {
  id                       String   @id @default(uuid())
  productId                String   @unique
  brand                    String?
  formFactor               String
  supportedFormFactors     String[] @default([])
  maxGpuLength             Int
  maxCoolerHeight          Int?
  includesPsu              Boolean
  includedFans             Int
  radiatorSupportMm        Int?
  radiatorSupportMmValues  String[] @default([])
  product                  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CoolerSpecs {
  id                String   @id @default(uuid())
  productId         String   @unique
  brand             String?
  type              String
  socketSupport     String
  compatibleSockets String[] @default([])
  fanCount          Int
  radiatorSize      Int?
  hasRGB            Boolean
  hasScreen         Boolean
  tdpCapacity       Int?
  coolerHeight      Int?
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StorageSpecs {
  id           String  @id @default(uuid())
  productId    String  @unique
  type         String
  capacity     Int
  interface    String
  readSpeed    Int?
  writeSpeed   Int?
  m2FormFactor String?
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model LaptopSpecs {
  id              String   @id @default(uuid())
  productId       String   @unique
  brand           String?
  processor       String
  ram             String
  storage         String
  screenSize      String
  refreshRate     Int
  panelType       String
  hasDedicatedGpu Boolean  @default(false)
  gpuBrand        String?
  gpuModel        String?
  includesWindows Boolean?
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DesktopSpecs {
  id              String  @id @default(uuid())
  productId       String  @unique
  processor       String
  ram             String
  storage         String
  hasDedicatedGpu Boolean @default(false)
  gpuBrand        String?
  gpuModel        String?
  coolerType      String?
  psuWatts        Int?
  caseModel       String?
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SoftwareSpecs {
  id          String  @id @default(uuid())
  productId   String  @unique
  licenseType String
  platform    String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MonitorSpecs {
  id             String   @id @default(uuid())
  productId      String   @unique
  brand          String?
  screenSize     String
  resolution     String
  panelType      String
  refreshRate    Int
  responseTimeMs Float?
  ports          String[] @default([])
  hasSpeakers    Boolean?
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model KeyboardSpecs {
  id                 String   @id @default(uuid())
  productId          String   @unique
  connection         String
  switchType         String
  layout             String
  hasRGB             Boolean
  brand              String?
  keyboardType       String?
  connections        String[] @default([])
  layoutLanguage     String?
  hasLighting        Boolean?
  keyboardFormFactor String?
  weightGrams        Int?
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MouseSpecs {
  id            String   @id @default(uuid())
  productId     String   @unique
  connection    String
  dpi           Int
  sensor        String
  hasRGB        Boolean
  brand         String?
  mouseType     String?
  connections   String[] @default([])
  buttonCount   Int?
  pollingRateHz Int?
  weightGrams   Int?
  powerType     String?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MousepadSpecs {
  id        String   @id @default(uuid())
  productId String   @unique
  brand     String?
  widthCm   Int?
  lengthCm  Int?
  hasLed    Boolean?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ChairSpecs {
  id          String  @id @default(uuid())
  productId   String  @unique
  brand       String?
  color       String?
  material    String?
  maxWeightKg Int?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GamingDeskSpecs {
  id        String  @id @default(uuid())
  productId String  @unique
  brand     String?
  color     String?
  surface   String?
  weightKg  Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model HeadsetSpecs {
  id                   String   @id @default(uuid())
  productId            String   @unique
  brand                String?
  connection           String
  supportedConnections String[] @default([])
  driverSize           Int
  impedance            Int
  micType              String
  noiseCancel          Boolean
  hasRGB               Boolean
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MicrophoneSpecs {
  id         String  @id @default(uuid())
  productId  String  @unique
  brand      String?
  connection String
  micType    String
  hasRGB     Boolean
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SpeakerSpecs {
  id         String  @id @default(uuid())
  productId  String  @unique
  brand      String?
  connection String
  wattage    Int
  hasRGB     Boolean
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model WebcamSpecs {
  id         String  @id @default(uuid())
  productId  String  @unique
  brand      String?
  resolution String
  fps        Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CaptureCardSpecs {
  id         String  @id @default(uuid())
  productId  String  @unique
  brand      String?
  resolution String
  fps        Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CableHubSpecs {
  id                String   @id @default(uuid())
  productId         String   @unique
  brand             String?
  type              String
  cableType         String?
  cableLengthMeters Int?
  hubInputType      String?
  hasHdmiOutput     Boolean?
  hasRj45Output     Boolean?
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model LaptopCoolingBaseSpecs {
  id           String  @id @default(uuid())
  productId    String  @unique
  brand        String?
  fanCount     Int
  connectivity String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BackpackSpecs {
  id        String  @id @default(uuid())
  productId String  @unique
  brand     String?
  color     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String
  name             String
  birthDate        DateTime?
  documentType     String?
  documentNumber   String?
  gender           String?
  mobilePhone      String?
  role             String      @default("EDITOR")
  emailVerified    Boolean     @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime    @default(now())
  resetToken       String?     @unique
  resetTokenExpiry DateTime?
  status           String      @default("ACTIVE")
  updatedAt        DateTime    @updatedAt
  addresses        Address[]
  accountTokens    AccountToken[]
  logs             ActionLog[]
  orders           Order[]
}

enum AccountTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  SET_PASSWORD
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  tokenHash String           @unique
  type      AccountTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([type, expiresAt])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String
  department  String
  province    String
  district    String
  addressLine String
  reference   String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActionLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entity      String
  details     String
  module      String?
  entityType  String?
  entityId    String?
  entityName  String?
  fieldName   String?
  oldValue    String?
  newValue    String?
  stockBefore Int?
  stockAfter  Int?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

enum CategoryType {
  CPU
  MOTHERBOARD
  RAM
  GPU
  STORAGE
  PSU
  CASE
  COOLER
  PERIPHERAL
  MONITOR
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  REJECTED
  PENDING_REVIEW
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  PENDING_REVIEW
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD_CREDIT
  CARD_DEBIT
  YAPE
  PLIN
}

enum PaymentProvider {
  SIMULATED
  FUTURE_NIUBIZ
  MANUAL
}

model Order {
  id        String      @id @default(uuid())
  userId    String?
  status    OrderStatus @default(PENDING_PAYMENT)
  subtotal  Decimal     @db.Decimal(10, 2)
  igv       Decimal     @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  currency  String      @default("PEN")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  paidAt    DateTime?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  productId           String
  productNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)
  quantity            Int
  subtotal            Decimal @db.Decimal(10, 2)
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String
  provider              PaymentProvider
  method                PaymentMethod
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @default("PEN")
  commissionRate        Decimal         @db.Decimal(5, 4)
  commissionAmount      Decimal         @db.Decimal(10, 2)
  providerTransactionId String?
  approvalCode          String?
  operationCode         String?
  customerNote          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  paidAt                DateTime?
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id           String    @id @default(uuid())
  key          String
  userId       String?
  route        String
  method       String
  requestHash  String
  status       String
  responseBody Json?
  statusCode   Int?
  lockedAt     DateTime?
  completedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([key, route, method])
  @@index([userId])
  @@index([expiresAt])
}

model StoreBranding {
  id        String   @id @default(uuid())
  storeName String   @default("PCSystemStore")
  logoUrl   String?
  logoAlt   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeBanner {
  id             String    @id @default(uuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
