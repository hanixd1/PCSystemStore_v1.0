# Copy to .env (never committed) and adjust.
PCS_PROJECT_ROOT=.
# Pretrained weights are cached inside the project so a Hugging Face update cannot change results.
HF_HOME=./models_cache
HF_HUB_DISABLE_TELEMETRY=1
# Global seed used when a run does not declare its own.
PCS_GLOBAL_SEED=20260101
# SonarQube (local Docker instance). Generate the token in the SonarQube UI.
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
# Only for `make sonar-gate` (User token with gate administration). Remove after use.
SONAR_ADMIN_TOKEN=
