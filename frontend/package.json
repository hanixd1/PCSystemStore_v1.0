{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"store/**/*.{ts,tsx}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"store/**/*.{ts,tsx}\" \"*.{js,mjs,ts,json}\"",
    "quality": "npm run lint && npm run build",
    "clean": "if exist .next rmdir /s /q .next"
  },
  "dependencies": {
    "@types/react-slick": "^0.23.13",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "next": "16.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "8.5.19",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "form-data": "4.0.6",
      "postcss": "^8.5.23"
    }
  }
}
