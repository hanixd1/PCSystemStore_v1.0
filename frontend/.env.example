# Local development. In Vercel Production use the canonical/API values shown below.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Vercel Production:
# NEXT_PUBLIC_API_URL=https://pcsystemstorebackend-production.up.railway.app
# NEXT_PUBLIC_SITE_URL=https://www.pcsystemstore.com
#
# Optional public build label. NEXT_PUBLIC_COMMIT_SHA falls back automatically
# to VERCEL_GIT_COMMIT_SHA during a Vercel build.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_COMMIT_SHA=
# Required only when product/branding images use a Cloudinary account.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_STORE_MAP_QUERY=
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_CHECKOUT_MODE=CONTACT_ONLY
NEXT_PUBLIC_WHATSAPP_NUMBER=
